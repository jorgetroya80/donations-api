# PostgreSQL credentials — used by compose.yaml (dev) and docker-compose.yml (prod)
POSTGRES_DB=db-name
POSTGRES_USER=use
# Change this to a strong secret in production
POSTGRES_PASSWORD=password

# CORS allowed origins (comma-separated). Set to your real domain in production.
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com

SPRING_DATASOURCE_URL=jdbc:postgresql://server-url/db-name?sslmode=require
SPRING_DATASOURCE_USERNAME=username
SPRING_DATASOURCE_PASSWORD=password