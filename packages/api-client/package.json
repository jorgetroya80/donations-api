{
  "name": "@jorgetroya80/donations-api-client",
  "version": "0.0.0",
  "description": "Generated TypeScript client for Church Donations API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
